{
  "display_name": "Svelte Language Server",
  "description": "Svelte language support in MIKE: completions, hover, and diagnostics for .svelte files, from svelte-language-server running in a sandboxed container. It is the Svelte community's language tooling; getmike.dev only packages it, and is not affiliated with, endorsed by, or sponsored by the Svelte project or its maintainers.",
  "author": "getmike.dev",
  "homepage": "https://github.com/sveltejs/svelte-language-server",
  "license_url": "https://github.com/sveltejs/svelte-language-server/blob/master/LICENSE",
  "version": "0.1.0",
  "capabilities": {
    "lsp": {
      "command": "svelteserver",
      "args": [
        "--stdio"
      ],
      "file_types": [
        {
          "extension": "svelte",
          "language_id": "svelte",
          "label": "Svelte",
          "syntax": "svelte"
        }
      ],
      "syntax": {
        "svelte": {
          "block_comment": {
            "open": "<!--",
            "close": "-->"
          },
          "strings": [
            {
              "quote": "`",
              "escapes": true,
              "multiline": true
            },
            {
              "quote": "\"",
              "escapes": true
            },
            {
              "quote": "'",
              "escapes": true
            }
          ],
          "pairs": [
            {
              "open": "{",
              "close": "}"
            },
            {
              "open": "(",
              "close": ")"
            },
            {
              "open": "[",
              "close": "]"
            }
          ],
          "keywords": [
            "each",
            "if",
            "await",
            "then",
            "catch",
            "html",
            "key",
            "const",
            "debug",
            "render",
            "snippet",
            "transition",
            "animate",
            "in",
            "out",
            "action",
            "bind",
            "bind:this",
            "class",
            "style",
            "props",
            "legacy",
            "svelte",
            "window",
            "document"
          ],
          "constants": [
            "true",
            "false",
            "null",
            "undefined"
          ],
          "numbers": true,
          "capitalized_types": true,
          "call_as_function": true
        }
      },
      "language": "svelte",
      "sandbox": {
        "reload_files": [
          "svelte.config.js",
          "svelte.config.mjs",
          "svelte.config.ts",
          "tsconfig.json"
        ]
      }
    }
  }
}
