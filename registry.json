    {
        "name": "clangd",
        "version": "0.1.0",
        "type": "lsp",
        "display_name": "C/C++ Language Server",
        "description": "C and C++ language support in MIKE: completions, hover, diagnostics, go-to-definition, references, rename, and formatting, from clangd running in a sandboxed container. clangd is the LLVM project's C/C++ language server; getmike.dev only packages it, and is not affiliated with, endorsed by, or sponsored by the LLVM project or the LLVM Foundation.",
        "author": "getmike.dev",
        "homepage": "https://clangd.llvm.org/",
        "license_url": "https://llvm.org/LICENSE.txt",
        "repo": "https://github.com/SoftwareRenderer/MIKE-extensions",
        "commit": "8dd05550f9c8a2faa7d788575b500803f6d2e4df",
        "subdir": "lsp/clangd",
        "capabilities": {
            "lsp": {
                "language": "cpp",
                "file_types": [
                    {
                        "extension": "c",
                        "language_id": "c",
                        "label": "C"
                    },
                    {
                        "extension": "h",
                        "language_id": "c",
                        "label": "C header"
                    },
                    {
                        "extension": "cpp",
                        "language_id": "cpp",
                        "label": "C++"
                    },
                    {
                        "extension": "cxx",
                        "language_id": "cpp",
                        "label": "C++"
                    },
                    {
                        "extension": "cc",
                        "language_id": "cpp",
                        "label": "C++"
                    },
                    {
                        "extension": "hpp",
                        "language_id": "cpp",
                        "label": "C++ header"
                    },
                    {
                        "extension": "hh",
                        "language_id": "cpp",
                        "label": "C++ header"
                    },
                    {
                        "extension": "hxx",
                        "language_id": "cpp",
                        "label": "C++ header"
                    }
                ],
                "environment_note": "clangd resolves this project from a compile_commands.json that is not there, so it is guessing include paths and flags: header and symbol errors below may be about the missing compilation database, not the code. Generate it from the build system (cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON, bear -- <build command>) in a task."
            }
        }
    },
