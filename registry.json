[
    {
        "name": "github-issue-importer",
        "version": "1.0.0",
        "type": "ui",
        "display_name": "GitHub Issue Importer",
        "description": "Automatically imports GitHub issue content when a relevant URL is pasted into task description.",
        "author": "SoftwareRenderer",
        "homepage": "https://github.com/SoftwareRenderer",
        "repo": "https://github.com/SoftwareRenderer/MIKE-extensions",
        "commit": "4e211bdecbedc4ad6e5b3e3871d2127f089e134a",
        "subdir": "ui/github-issue-importer",
        "capabilities": {
            "ui": {
                "injection_points": [
                    "createTask"
                ],
                "permissions": [
                    "createTask.description.insertText",
                    "createTask.events.paste",
                    "network.proxy"
                ]
            },
            "network": {
                "allowed_domains": [
                    "api.github.com"
                ]
            }
        }
    },
    {
        "name": "gopls",
        "version": "1.0.0",
        "type": "lsp",
        "display_name": "Go Language Server",
        "description": "Go language server (gopls) by Google. Provides completions, hover, diagnostics, go-to-definition, and more for Go projects.",
        "author": "Go Team",
        "homepage": "https://github.com/golang/tools/tree/master/gopls",
        "license_url": "https://github.com/golang/tools/blob/master/LICENSE",
        "repo": "https://github.com/SoftwareRenderer/MIKE-extensions",
        "commit": "17e42842088ab6ee54e18b78c5041424ce5e44b1",
        "subdir": "lsp/gopls",
        "capabilities": {
            "lsp": {
                "language": "go",
                "extensions": [
                    "go"
                ]
            }
        }
    },
    {
        "name": "html-preview",
        "version": "1.0.0",
        "type": "ui",
        "display_name": "HTML Preview",
        "description": "Adds a Preview button to the editor footer for HTML, XHTML, and SVG files. Renders the code view's content in an isolated preview that updates live as the file changes — in the editor or on disk. The page may navigate within the project tree (sibling and subdirectory pages); leaving the tree stops the preview with a warning.",
        "author": "SoftwareRenderer",
        "homepage": "https://github.com/SoftwareRenderer",
        "repo": "https://github.com/SoftwareRenderer/MIKE-extensions",
        "commit": "3384bc983f91d7e00d414babd9058456179fc52b",
        "subdir": "ui/html-preview",
        "capabilities": {
            "ui": {
                "injection_points": [
                    "fileEditor"
                ],
                "permissions": [
                    "editor.addFooterButton",
                    "editor.setOverlay",
                    "preview.serveScripts",
                    "preview.serveNetwork",
                    "editor.getContent",
                    "ui.modal"
                ]
            }
        }
    },
    {
        "name": "markdown-preview",
        "version": "1.0.0",
        "type": "ui",
        "display_name": "Markdown Preview",
        "description": "Adds a Preview button to the editor footer for Markdown files, toggling between the code and WYSIWYG editor.",
        "author": "SoftwareRenderer",
        "homepage": "https://github.com/SoftwareRenderer",
        "repo": "https://github.com/SoftwareRenderer/MIKE-extensions",
        "commit": "3daf07716445bb87fed60b0c114943fd21f25f9f",
        "subdir": "ui/markdown-preview",
        "capabilities": {
            "ui": {
                "injection_points": [
                    "fileEditor"
                ],
                "permissions": [
                    "editor.addFooterButton",
                    "editor.getContent",
                    "editor.setContent",
                    "editor.setOverlay",
                    "editor.jumpToLine",
                    "editor.save"
                ]
            }
        }
    },
    {
        "name": "mike-light",
        "version": "1.0.0",
