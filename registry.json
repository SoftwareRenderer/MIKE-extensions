    {
        "name": "gopls",
        "version": "0.7.0",
        "type": "lsp",
        "display_name": "Go Language Server",
        "description": "Go language support in MIKE: completions, hover, diagnostics, go-to-definition, and more, from gopls running in a sandboxed container. gopls is Google's; getmike.dev only packages it, and is not affiliated with, endorsed by, or sponsored by Google LLC.",
        "author": "getmike.dev",
        "homepage": "https://github.com/golang/tools/tree/master/gopls",
        "license_url": "https://github.com/golang/tools/blob/master/LICENSE",
        "repo": "https://github.com/SoftwareRenderer/MIKE-extensions",
        "commit": "8dd05550f9c8a2faa7d788575b500803f6d2e4df",
        "subdir": "lsp/gopls",
        "capabilities": {
            "lsp": {
                "language": "go",
                "file_types": [
                    {
                        "extension": "go",
                        "language_id": "go",
                        "label": "Go"
                    }
                ],
                "environment_note": "gopls cannot resolve this project's dependencies in the sandbox: the Go module cache is not reachable. Import and undefined-name errors below are its guesses about a package it could not load, not findings about this code. Name a host directory for the Go module cache under Settings -> Extensions -> gopls (Edit, Dependencies) and fill it there: run \"go mod download\" into it, or add it to the project's Sandbox Configuration mounts with GOMODCACHE set to its container path so a task can download into it.",
                "dependency_cache": {
                    "container_path": "/go/pkg/mod",
                    "env": "GOMODCACHE"
                }
            }
        }
    },
    {
        "name": "html-preview",
        "version": "0.7.0",
        "type": "ui",
        "display_name": "HTML Preview",
        "description": "Adds a Preview button to the editor footer for HTML, XHTML, and SVG files. Renders the code view's content in an isolated preview that updates live as the file changes — in the editor or on disk. The page may navigate within the project tree (sibling and subdirectory pages); leaving the tree stops the preview with a warning.",
        "author": "SoftwareRenderer",
        "homepage": "https://github.com/SoftwareRenderer",
        "repo": "https://github.com/SoftwareRenderer/MIKE-extensions",
        "commit": "8dd05550f9c8a2faa7d788575b500803f6d2e4df",
        "subdir": "ui/html-preview",
        "capabilities": {
            "ui": {
                "injection_points": [
                    "fileEditor"
                ],
                "permissions": [
                    "editor.addFooterButton",
                    "editor.setOverlay",
                    "preview.serveScripts",
                    "preview.serveNetwork",
                    "editor.getContent",
                    "ui.modal"
                ]
            }
        }
    },
