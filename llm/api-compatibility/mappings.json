[
  {
    "match": "https://openrouter.ai",
    "headers": {
      "HTTP-Referer": "https://getmike.dev",
      "X-OpenRouter-Title": "MIKE: Integrated Kanban Env.",
      "X-OpenRouter-Categories": "programming-app"
    },
    "body": {
      "remove": [
        "thinking_budget_tokens",
        "reasoning_control",
        "reasoning_effort",
        "chat_template_kwargs",
        "return_progress"
      ],
      "remove_if": {
        "tool_choice": "tools"
      },
      "set": {
        "reasoning.effort": {
          "value": "{{reasoning_effort}}",
          "when": ["max", "xhigh", "high", "medium", "low", "minimal", "none"]
        },
        "reasoning.enabled": {
          "from": "reasoning_effort",
          "value": true,
          "when": ["", "default"]
        }
      }
    }
  },
  {
    "match": "https://api.deepseek.com",
    "body": {
      "remove": [
        "thinking_budget_tokens",
        "reasoning_control",
        "chat_template_kwargs",
        "return_progress"
      ],
      "set": {
        "thinking.type": {
          "from": "reasoning_effort",
          "value": {
            "none": "disabled",
            "off": "disabled",
            "*": "enabled"
          }
        }
      }
    }
  },
  {
    "match": "https://dashscope-intl.aliyuncs.com",
    "body": {
      "remove": [
        "thinking_budget_tokens",
        "reasoning_control",
        "chat_template_kwargs",
        "return_progress"
      ],
      "set": {
        "enable_thinking": {
          "from": "reasoning_effort",
          "value": {
            "none": false,
            "off": false,
            "*": true
          }
        }
      }
    }
  },
  {
    "match": "https://generativelanguage.googleapis.com",
    "body": {
      "remove": [
        "thinking_budget_tokens",
        "reasoning_control",
        "chat_template_kwargs",
        "return_progress"
      ]
    }
  }
]
